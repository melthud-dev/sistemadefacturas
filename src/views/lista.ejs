<!doctype html>
<html lang="es">
<head>
  <%- include('partials/head') %>
  <title>Comprobantes - Recibera</title>
</head>
<body>
  <div class="app-shell">
    <%- include('partials/sidebar', { active: 'comprobantes' }) %>

    <div class="content">
      <div class="page-header">
        <div>
          <h1>Comprobantes</h1>
          <div class="sub"><%= comprobantes.length %> comprobante<%= comprobantes.length === 1 ? '' : 's' %> en total</div>
        </div>
        <a href="/comprobantes/nuevo" class="btn btn-primary">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
          Nuevo comprobante
        </a>
      </div>

      <div class="stat-cards">
        <div class="stat-card">
          <div class="label">Emitidos este mes</div>
          <div class="value"><%= stats.totalMes %></div>
        </div>
        <div class="stat-card">
          <div class="label">Monto total este mes</div>
          <div class="value">USD <%= stats.montoTotalMes.toFixed(2) %></div>
        </div>
        <div class="stat-card">
          <div class="label">Enviados por correo</div>
          <div class="value accent"><%= stats.enviadosMes %> de <%= stats.totalMes %></div>
        </div>
      </div>

      <% if (comprobantes.length === 0) { %>
        <div class="table-card">
          <div class="empty-state">Aún no hay comprobantes. <a href="/comprobantes/nuevo" style="color:var(--accent);font-weight:600;">Crea el primero</a>.</div>
        </div>
      <% } else { %>
        <div class="search-box" style="margin-top:22px;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#A39C8C" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
          <input type="text" id="buscador" placeholder="Buscar por nombre o cédula..." oninput="filtrarComprobantes()" />
        </div>

        <div class="table-card">
          <div class="table-row table-head">
            <span>Número</span>
            <span>Cliente</span>
            <span>Cédula</span>
            <span>Fecha</span>
            <span>Monto</span>
            <span>Estado</span>
            <span></span>
          </div>
          <div class="table-body" id="tabla-body">
            <% comprobantes.forEach(c => { %>
              <a href="/comprobantes/<%= c.id %>" class="table-row"
                 data-search="<%= [c.cliente_nombre, c.cliente_doc].filter(Boolean).join(' ').toLowerCase() %>">
                <span class="numero"><%= c.numero %></span>
                <span class="cliente"><%= c.cliente_nombre %></span>
                <span class="fecha"><%= c.cliente_doc || '—' %></span>
                <span class="fecha"><%= new Date(c.fecha).toLocaleDateString('es-EC') %></span>
                <span class="monto"><%= c.moneda %> <%= Number(c.monto).toFixed(2) %></span>
                <span>
                  <span class="badge badge-<%= c.estado %>">
                    <span class="dot"></span>
                    <% if (c.estado === 'enviado') { %>Enviado<% } else if (c.estado === 'emitido') { %>Emitido<% } else { %>Error de envío<% } %>
                  </span>
                </span>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#A39C8C" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
              </a>
            <% }) %>
          </div>
          <div class="empty-state" id="sin-resultados" style="display:none;">No se encontraron comprobantes que coincidan con la búsqueda.</div>
        </div>
      <% } %>
    </div>
  </div>

  <script>
    function filtrarComprobantes() {
      var q = document.getElementById('buscador').value.trim().toLowerCase();
      var filas = document.querySelectorAll('#tabla-body .table-row');
      var visibles = 0;
      filas.forEach(function (fila) {
        var coincide = fila.getAttribute('data-search').indexOf(q) !== -1;
        fila.style.display = coincide ? '' : 'none';
        if (coincide) visibles++;
      });
      document.getElementById('sin-resultados').style.display = visibles === 0 ? 'block' : 'none';
    }
  </script>
</body>
</html>
