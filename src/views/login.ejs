<!doctype html>
<html lang="es">
<head>
  <%- include('partials/head') %>
  <title>Ingresar - Recibera</title>
</head>
<body>
  <div class="login-shell">
    <div class="login-brand">
      <div class="brand">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#F5F3EE" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h9l3 3v15l-2-1.2-2 1.2-2-1.2-2 1.2-2-1.2-2 1.2V3z"/><path d="M9 8h6M9 12h6M9 16h3"/></svg>
        <span>Recibera</span>
      </div>

      <div>
        <h1>Comprobantes de pago, generados y enviados en segundos.</h1>
        <div class="tagline">Genera el PDF, archívalo automáticamente y notifica al cliente por correo — todo desde un mismo lugar.</div>
      </div>

      <div style="display:flex;gap:28px;">
        <div>
          <div style="font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:600;color:#F5F3EE;">100%</div>
          <div style="font-size:11.5px;color:#7E9689;margin-top:2px;">Trazabilidad</div>
        </div>
        <div>
          <div style="font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:600;color:#F5F3EE;">PDF</div>
          <div style="font-size:11.5px;color:#7E9689;margin-top:2px;">Archivo automático</div>
        </div>
        <div>
          <div style="font-family:'Space Grotesk',sans-serif;font-size:20px;font-weight:600;color:#F5F3EE;">Auto</div>
          <div style="font-size:11.5px;color:#7E9689;margin-top:2px;">Envío por correo</div>
        </div>
      </div>
    </div>

    <div class="login-form-wrap">
      <form class="login-form" method="POST" action="/login">
        <h2>Ingresar</h2>
        <p class="sub">Usa tu cuenta de contabilidad para continuar.</p>

        <% if (error) { %>
          <div class="error" style="margin-top:18px;margin-bottom:0;"><%= error %></div>
        <% } %>

        <label for="username">Usuario</label>
        <input type="text" id="username" name="username" required autofocus />

        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" required />

        <button type="submit" class="btn btn-primary">Ingresar</button>

        <div class="login-footer">Recibera · uso interno · BQC</div>
      </form>
    </div>
  </div>
</body>
</html>
