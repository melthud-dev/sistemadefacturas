<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <title>Nuevo comprobante - Recibera</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="topbar">
    <a href="/comprobantes">&larr; Recibera</a>
    <form method="POST" action="/logout"><button type="submit" style="margin:0; background:#6b7280;">Salir</button></form>
  </div>

  <div class="container">
    <div class="card">
      <h1>Nuevo comprobante de pago</h1>

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <form method="POST" action="/comprobantes">
        <label for="cliente_nombre">Nombre del cliente *</label>
        <input type="text" id="cliente_nombre" name="cliente_nombre" value="<%= form.cliente_nombre || '' %>" required autofocus />

        <label for="cliente_doc">Documento (cedula/RUC)</label>
        <input type="text" id="cliente_doc" name="cliente_doc" value="<%= form.cliente_doc || '' %>" />

        <label for="cliente_email">Correo del cliente (para enviar el comprobante)</label>
        <input type="email" id="cliente_email" name="cliente_email" value="<%= form.cliente_email || '' %>" />

        <label for="concepto">Concepto *</label>
        <textarea id="concepto" name="concepto" rows="3" required><%= form.concepto || '' %></textarea>

        <label for="monto">Monto *</label>
        <input type="number" id="monto" name="monto" step="0.01" min="0.01" value="<%= form.monto || '' %>" required />

        <label for="moneda">Moneda</label>
        <select id="moneda" name="moneda">
          <option value="USD" selected>USD</option>
        </select>

        <label for="metodo_pago">Metodo de pago</label>
        <select id="metodo_pago" name="metodo_pago">
          <option value="Transferencia">Transferencia</option>
          <option value="Efectivo">Efectivo</option>
          <option value="Tarjeta">Tarjeta</option>
          <option value="Deposito">Deposito</option>
          <option value="Otro">Otro</option>
        </select>

        <button type="submit">Generar y enviar comprobante</button>
      </form>
    </div>
  </div>
</body>
</html>
