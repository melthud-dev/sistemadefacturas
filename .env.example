# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el archivo .env real a git.

# --- Base de datos ---
POSTGRES_USER=recibera
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=recibera
DATABASE_URL=postgresql://recibera:cambia_esta_clave@db:5432/recibera

# --- Sesiones ---
SESSION_SECRET=genera_un_secreto_largo_y_aleatorio

# --- SMTP (Gmail) ---
# Usa una "Contrasena de aplicacion" de Google, NO tu contrasena normal.
# Se genera en: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion
SMTP_FROM_NAME=Contabilidad

# --- App ---
PORT=3000
NODE_ENV=production
BASE_URL=http://localhost:3000

# --- Cloudflare Tunnel ---
# Se obtiene al crear el tunel en https://one.dash.cloudflare.com/ -> Networks -> Tunnels
TUNNEL_TOKEN=pega_aqui_el_token_del_tunel
