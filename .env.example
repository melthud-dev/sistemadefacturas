# Copia este archivo a .env y completa los valores reales.
# NUNCA subas el archivo .env real a git.

# --- Base de datos ---
POSTGRES_USER=recibera
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=recibera
DATABASE_URL=postgresql://recibera:cambia_esta_clave@db:5432/recibera

# --- Sesiones ---
SESSION_SECRET=genera_un_secreto_largo_y_aleatorio

# --- SMTP (Gmail) ---
# Requiere una "Contrasena de aplicacion" de Google (no la contrasena normal),
# se genera en https://myaccount.google.com/apppasswords (con verificacion en
# 2 pasos activada). Tambien funciona con un correo de hosting/cPanel: en ese
# caso usa el host/puerto que te de tu proveedor (ej. mail.tudominio.com).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contrasena_de_aplicacion
SMTP_FROM_NAME=Contabilidad

# --- App ---
PORT=3000
NODE_ENV=production
BASE_URL=http://localhost:3000
# false mientras se use local por HTTP; SIEMPRE poner en true en produccion
# (detras de Caddy/HTTPS) -- si no, las sesiones/login no funcionan bien.
COOKIE_SECURE=false

# --- Produccion: dominio + HTTPS automatico (Caddy) ---
# Solo se usan si levantas el perfil "prod" (ver README). El DNS de
# RECIBERA_DOMAIN debe apuntar a la IP publica de este servidor ANTES de
# levantar Caddy, o no podra emitir el certificado de Let's Encrypt.
RECIBERA_DOMAIN=recibera.tudominio.com
ACME_EMAIL=tu_correo@tudominio.com

# --- Alternativa: Cloudflare Tunnel (opcional, no usar junto con Caddy) ---
# Se obtiene al crear el tunel en https://one.dash.cloudflare.com/ -> Networks -> Tunnels
TUNNEL_TOKEN=
